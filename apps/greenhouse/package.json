{
	"name": "greenhouse",
	"description": "The Greenhouse CLI for setting up your Linux and macOS dev environments.",
	"version": "0.0.1",
	"author": "Mat Teague",
	"bin": {
		"greenhouse": "./bin/run.js",
		"ghp": "./bin/run.js"
	},
	"bugs": "https://github.com/YewTreeWeb/greenhouse/issues",
	"homepage": "https://github.com/YewTreeWeb/greenhouse",
	"repository": "YewTreeWeb/greenhouse",
	"engines": {
		"node": ">=18.0.0"
	},
	"files": [
		"./bin",
		"./dist",
		"./oclif.manifest.json"
	],
	"keywords": [
		"oclif"
	],
	"license": "MIT",
	"main": "dist/index.js",
	"type": "module",
	"types": "dist/index.d.ts",
	"oclif": {
		"bin": "greenhouse",
		"dirname": "greenhouse",
		"topicSeparator": " ",
		"plugins": [
			"@oclif/plugin-help",
			"@greenhouse/terrarium",
			"@greenhouse/sprout",
			"@greenhouse/cultivate",
			"@greenhouse/planter",
			"@greenhouse/branch",
			"@greenhouse/orchard",
			"@greenhouse/bud",
			"@greenhouse/harvest",
			"@greenhouse/seedbank",
			"@greenhouse/prune",
			"@greenhouse/water",
			"@greenhouse/fertilize",
			"@greenhouse/botanist",
			"@greenhouse/gardener"
		]
	},
	"dependencies": {
		"ora": "^9.0.0",
		"execa": "^9.6.0",
		"@oclif/core": "^4"
	},
	"devDependencies": {
		"typescript": "^5",
		"@types/chai": "^4",
		"@types/mocha": "^10.0.10",
		"@types/node": "^18",
		"ts-node": "^10",
		"mocha": "^10",
		"oclif": "^4",
		"shx": "^0.3.3"
	},
	"scripts": {
		"build": "shx rm -rf dist && tsc -b",
		"dev": "./bin/dev.js",
		"lint": "biome check .",
		"postpack": "shx rm -f oclif.manifest.json",
		"posttest": "pnpm run lint",
		"prepack": "oclif manifest && oclif readme",
		"start": "./bin/run.js",
		"test": "mocha --forbid-only \"test/**/*.test.ts\"",
		"version": "oclif readme && git add README.md"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://verdaccio.teamteaguehomelab.uk/"
	}
}
