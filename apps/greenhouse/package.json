{
  "name": "greenhouse",
  "description": "The Greenhouse CLI for setting up your Linux and macOS dev environments.",
  "version": "0.0.0",
  "author": "Mat Teague",
  "bin": {
    "greenhouse": "./bin/run.js",
    "ghp": "./bin/run.js"
  },
  "bugs": "https://github.com/YewTreeWeb/greenhouse/issues",
  "homepage": "https://github.com/YewTreeWeb/greenhouse",
  "repository": "YewTreeWeb/greenhouse",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "keywords": [
    "oclif"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "oclif": {
    "bin": "greenhouse",
    "dirname": "greenhouse",
    "topicSeparator": " ",
    "plugins": [
      "@oclif/plugin-help",
      "@greenhouse/terrarium",
      "@greenhouse/sprout",
      "@greenhouse/cultivate",
      "@greenhouse/planter",
      "@greenhouse/branch",
      "@greenhouse/orchard",
      "@greenhouse/bud",
      "@greenhouse/harvest",
      "@greenhouse/seedbank",
      "@greenhouse/prune",
      "@greenhouse/water",
      "@greenhouse/fertilize",
      "@greenhouse/botanist",
      "@greenhouse/gardener"
    ]
  },
  "dependencies": {
    "@greenhouse/botanist": "workspace:*",
    "@greenhouse/branch": "workspace:*",
    "@greenhouse/bud": "workspace:*",
    "@greenhouse/cultivate": "workspace:*",
    "@greenhouse/fertilize": "workspace:*",
    "@greenhouse/gardener": "workspace:*",
    "@greenhouse/harvest": "workspace:*",
    "@greenhouse/orchard": "workspace:*",
    "@greenhouse/planter": "workspace:*",
    "@greenhouse/prune": "workspace:*",
    "@greenhouse/seedbank": "workspace:*",
    "@greenhouse/sprout": "workspace:*",
    "@greenhouse/terrarium": "workspace:*",
    "@greenhouse/water": "workspace:*",
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "@oclif/plugin-plugins": "^5",
    "clack": "^0.1.0",
    "execa": "^9.6.0",
    "ora": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^10",
    "oclif": "^4",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "dev": "./bin/dev.js",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "pnpm run lint",
    "prepack": "oclif manifest && oclif readme",
    "start": "./bin/run.js",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  }
}
