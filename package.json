{
	"name": "greenhouse",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"dev:cli": "pnpm --filter greenhouse dev",
		"dev:dash": "pnpm --filter sunroom dev",
		"build": "pnpm -r build",
		"start": "pnpm --filter greenhouse start",
		"start:dash": "pnpm --filter sunroom start",
		"sunroom": "pnpm --filter sunroom start",
		"lint": "biome check .",
		"format": "biome format --write .",
		"commit": "cz",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"commitizen": "^4.3.2",
		"cz-git": "^1.13.2",
		"pnpm": "^10.18.3",
		"typescript": "^5.9.3",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0"
	},
	"config": {
		"commitizen": {
			"path": "cz-git"
		}
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,jsonc}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
