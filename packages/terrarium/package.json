{
  "name": "@greenhouse/terrarium",
  "version": "0.0.0",
  "description": "Bootstrap a fresh Mac or Linux machine — Nix-first setup, Homebrew (macOS), dotfiles, SSH, git config",
  "keywords": [
    "oclif"
  ],
  "license": "MIT",
  "author": "Mat Teague",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "terrarium": "./bin/run.js"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "dev": "./bin/dev.js",
    "format": "biome format --write .",
    "lint": "pnpm lint:biome && pnpm lint:oxlint",
    "lint:biome": "biome check . --write --no-errors-on-unmatched",
    "lint:oxlint": "oxlint -c oxlint.config.ts --fix",
    "prepack": "oclif manifest && oclif readme",
    "postpack": "shx rm -f oclif.manifest.json",
    "start": "./bin/run.js",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "posttest": "pnpm run lint"
  },
  "oclif": {
    "bin": "terrarium",
    "commands": "./dist/commands",
    "dirname": "terrarium",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " "
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@greenhouse/shared": "workspace:*",
    "@oclif/core": "^4",
    "execa": "^9.6.0",
    "ora": "^9.0.0"
  },
  "devDependencies": {
    "@types/chai": "^4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.130",
    "mocha": "^10",
    "oclif": "^4",
    "oxlint": "^1.79.0",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://verdaccio.teamteaguehomelab.uk/"
  }
}
