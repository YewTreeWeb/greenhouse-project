{
	"name": "@greenhouse/orchard",
	"description": "Batch operations across projects",
	"version": "0.0.1",
	"author": "Mat Teague",
	"bin": {
		"orchard": "./bin/run.js"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"files": [
		"./bin",
		"./dist",
		"./oclif.manifest.json"
	],
	"keywords": [
		"oclif"
	],
	"license": "MIT",
	"main": "dist/index.js",
	"type": "module",
	"types": "dist/index.d.ts",
	"oclif": {
		"bin": "orchard",
		"dirname": "orchard",
		"commands": "./dist/commands",
		"plugins": [
			"@oclif/plugin-help"
		],
		"topicSeparator": " "
	},
	"dependencies": {
		"ora": "^9.0.0",
		"@oclif/core": "^4",
		"execa": "^9.6.0"
	},
	"devDependencies": {
		"typescript": "^5",
		"@types/chai": "^4",
		"@types/mocha": "^10.0.10",
		"@types/node": "^18",
		"ts-node": "^10",
		"mocha": "^10",
		"oclif": "^4",
		"shx": "^0.3.3"
	},
	"scripts": {
		"build": "shx rm -rf dist && tsc -b",
		"dev": "./bin/dev.js",
		"lint": "biome check .",
		"postpack": "shx rm -f oclif.manifest.json",
		"posttest": "pnpm run lint",
		"prepack": "oclif manifest && oclif readme",
		"start": "./bin/run.js",
		"test": "mocha --forbid-only \"test/**/*.test.ts\""
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://verdaccio.teamteaguehomelab.uk/"
	}
}
